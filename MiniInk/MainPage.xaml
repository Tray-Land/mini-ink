<Page
    x:Class="MiniInk.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiniInk">
    <Grid Padding="20" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Your quick notes" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="New note" Click="NewNote_Click"
                    AutomationProperties.AutomationId="NewNote" Style="{ThemeResource AccentButtonStyle}"/>
        </Grid>
        <AutoSuggestBox x:Name="Search" Grid.Row="1" Header="Search notes and handwriting"
                        PlaceholderText="Find a thought..." QueryIcon="Find" TextChanged="Search_TextChanged"
                        AutomationProperties.AutomationId="SearchNotes"/>
        <InfoBar x:Name="Error" Grid.Row="2" Severity="Error" IsClosable="True"/>
        <Grid Grid.Row="3">
            <ListView x:Name="NotesList" IsItemClickEnabled="True" ItemClick="NotesList_ItemClick"
                      SelectionMode="None" AutomationProperties.AutomationId="NotesList">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LibraryItem">
                        <Grid Padding="0,8" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Bind Title, Mode=OneTime}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="{x:Bind Preview, Mode=OneTime}" TextTrimming="CharacterEllipsis"
                                       MaxLines="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="2" Text="{x:Bind DateLabel, Mode=OneTime}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="Empty" Text="No notes yet. Capture your first idea."
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Open to a fresh page" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ComboBox x:Name="FreshAfter" Grid.Column="1" MinWidth="160" SelectionChanged="FreshAfter_SelectionChanged"
                      AutomationProperties.Name="Open to a fresh page" AutomationProperties.AutomationId="FreshAfter"
                      ToolTipService.ToolTip="How long MiniInk must be put down before it opens on a blank page instead of the last note"/>
        </Grid>
        <TextBlock Grid.Row="5" Text="Stored on this device. Handwriting is indexed automatically."
                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Page>
