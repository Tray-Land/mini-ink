<UserControl
    x:Class="MiniInk.InputToolsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Choices are in InputTool order. -->
    <StackPanel Spacing="12" MinWidth="180">
        <RadioButtons x:Name="MouseChoices" Header="Mouse" SelectionChanged="Choices_SelectionChanged"
                      AutomationProperties.Name="Mouse tool" AutomationProperties.AutomationId="MouseTool">
            <RadioButton Content="Select and drag" AutomationProperties.AutomationId="MouseSelect"/>
            <RadioButton Content="Draw" AutomationProperties.AutomationId="MouseDraw"/>
            <RadioButton Content="Add text" AutomationProperties.AutomationId="MouseText"/>
        </RadioButtons>
        <RadioButtons x:Name="TouchChoices" Header="Touch" SelectionChanged="Choices_SelectionChanged"
                      AutomationProperties.Name="Touch tool" AutomationProperties.AutomationId="TouchTool">
            <RadioButton Content="Select and drag" AutomationProperties.AutomationId="TouchSelect"/>
            <RadioButton Content="Draw" AutomationProperties.AutomationId="TouchDraw"/>
            <RadioButton Content="Add text" AutomationProperties.AutomationId="TouchText"/>
        </RadioButtons>
    </StackPanel>
</UserControl>
