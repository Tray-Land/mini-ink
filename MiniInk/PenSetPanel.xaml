<UserControl
    x:Class="MiniInk.PenSetPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RemovePenStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <!-- The pen being dragged by its handle, lifted off the rows around it. -->
        <Style x:Key="DraggedPenStyle" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="8">
        <!-- One row per pen, built in code from the pens the toolbars hold. -->
        <StackPanel x:Name="Rows" Spacing="2" AutomationProperties.AutomationId="PenList"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddButton" AutomationProperties.AutomationId="AddPen" AutomationProperties.Name="Add a pen">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="Add pen"/>
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="AddMenu"/>
                </Button.Flyout>
            </Button>
            <Button Content="Reset pens" Click="Reset_Click" AutomationProperties.AutomationId="ResetPens"
                    ToolTipService.ToolTip="Back to a pen, a pencil and a highlighter, each in its own starting color and size"/>
        </StackPanel>
        <TextBlock x:Name="Limit" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"/>
    </StackPanel>
</UserControl>
