<Page
    x:Class="MiniInk.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiniInk">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_Invoked"/>
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    <Grid x:Name="Layout" RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Header" ColumnSpacing="4">
            <Grid.Resources>
                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush"/>
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush"/>
                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush"/>
                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush"/>
                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush"/>
                <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush"/>
                <StaticResource x:Key="SplitButtonBackground" ResourceKey="SubtleFillColorTransparentBrush"/>
                <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush"/>
                <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush"/>
                <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush"/>
                <StaticResource x:Key="SplitButtonBorderBrushDivider" ResourceKey="SubtleFillColorTransparentBrush"/>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="LibraryButton" Click="Library_Click" Style="{StaticResource HeaderButtonStyle}"
                    AutomationProperties.AutomationId="BackToNotes" AutomationProperties.Name="All notes"
                    ToolTipService.ToolTip="All notes and search">
                <FontIcon Glyph="&#xE8FD;" FontSize="16"/>
            </Button>
            <TextBox x:Name="NoteTitle" Grid.Column="1" TextChanged="Title_TextChanged"
                     PlaceholderText="Note title" AutomationProperties.Name="Note title"
                     AutomationProperties.AutomationId="NoteTitle"/>
            <StackPanel x:Name="StackActions" Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <Button x:Name="OlderButton" Click="Older_Click" Style="{StaticResource HeaderButtonStyle}"
                        AutomationProperties.AutomationId="OlderNote" AutomationProperties.Name="Older note"
                        ToolTipService.ToolTip="Older note (Ctrl+Page Down)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="PageDown" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                </Button>
                <Button x:Name="NewerButton" Click="Newer_Click" Style="{StaticResource HeaderButtonStyle}"
                        AutomationProperties.AutomationId="NewerNote" AutomationProperties.Name="Newer note"
                        ToolTipService.ToolTip="Newer note (Ctrl+Page Up)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="PageUp" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                </Button>
                <!-- The button starts a blank page; its arrow starts one from a template. -->
                <SplitButton x:Name="NewPageButton" Click="NewPage_Click" Height="32" Padding="0" VerticalAlignment="Center"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             AutomationProperties.AutomationId="NewPage" AutomationProperties.Name="New page"
                             ToolTipService.ToolTip="New page (Ctrl+N), or pick a template">
                    <SplitButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewPage_Invoked"/>
                    </SplitButton.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE710;" FontSize="16"/>
                </SplitButton>
                <Button Click="TearOff_Click" Style="{StaticResource HeaderButtonStyle}"
                        AutomationProperties.AutomationId="TearOff" AutomationProperties.Name="Tear off into its own window"
                        ToolTipService.ToolTip="Tear off into its own window">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>
        <CommandBar x:Name="Commands" Grid.Row="1" DefaultLabelPosition="Collapsed" IsOpen="False" Background="Transparent">
            <CommandBar.Resources>
                <!-- Icon-only on the bar. A local Width would also pin a button that overflows to a centered 40px
                     sliver; set here, the overflow menu's own style stretches it to a full labeled row. -->
                <Style TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                    <Setter Property="Width" Value="40"/>
                </Style>
            </CommandBar.Resources>
            <CommandBar.Content>
                <InkToolbar x:Name="PenTools" InitialControls="All" AutomationProperties.AutomationId="PenTools"/>
            </CommandBar.Content>
            <AppBarButton Label="Mouse and touch" AutomationProperties.AutomationId="InputTools"
                          ToolTipService.ToolTip="What mouse and touch do">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7C9;"/>
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <local:InputToolsPanel/>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Edit" Label="Add text" Click="AddText_Click" AutomationProperties.AutomationId="AddText"
                          ToolTipService.ToolTip="Add text"/>
            <CommandBar.SecondaryCommands>
                <!-- Ctrl+S lives on the page, since this menu is out of the tree while it is closed. -->
                <AppBarButton Icon="Save" Label="Save" Click="Save_Click" AutomationProperties.AutomationId="SaveNote"
                              KeyboardAcceleratorTextOverride="Ctrl+S"/>
                <AppBarButton Icon="Delete" Label="Delete selected object" Click="Delete_Click" AutomationProperties.AutomationId="DeleteObject"/>
                <AppBarSeparator/>
                <AppBarButton Icon="Setting" Label="Settings" Click="Settings_Click" AutomationProperties.AutomationId="OpenSettings"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <InfoBar x:Name="Error" Grid.Row="2" Severity="Error" IsClosable="True"/>
        <ScrollViewer x:Name="CanvasScroll" Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" HorizontalContentAlignment="Left"
                      VerticalContentAlignment="Top" AutomationProperties.AutomationId="NoteCanvas"
                      AutomationProperties.Name="Note canvas" SizeChanged="CanvasScroll_SizeChanged">
            <Grid x:Name="Surface" Width="400" Height="400" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  ManipulationMode="None">
                <Canvas x:Name="TemplateLayer" IsHitTestVisible="False"/>
                <Canvas x:Name="TextLayer" IsHitTestVisible="False"/>
                <InkCanvas x:Name="Ink" AutomationProperties.AutomationId="InkCanvas"/>
                <Canvas x:Name="Adornments" IsHitTestVisible="False">
                    <Border x:Name="Selection" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                            BorderThickness="2" Visibility="Collapsed" CornerRadius="4"/>
                </Canvas>
                <Canvas x:Name="EditLayer">
                    <TextBox x:Name="TextEditor" Width="220" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap"
                             Visibility="Collapsed" TextChanged="TextEditor_TextChanged"
                             LostFocus="TextEditor_LostFocus" AutomationProperties.AutomationId="CanvasText"
                             AutomationProperties.Name="Text on the note canvas"/>
                </Canvas>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
