<Page
    x:Class="MiniInk.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Click="Library_Click" AutomationProperties.AutomationId="BackToNotes"
                    AutomationProperties.Name="Back to notes" ToolTipService.ToolTip="Back to notes"
                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>
            <TextBox x:Name="NoteTitle" Grid.Column="1" TextChanged="Title_TextChanged"
                     PlaceholderText="Note title" AutomationProperties.Name="Note title"
                     AutomationProperties.AutomationId="NoteTitle"/>
        </Grid>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Collapsed" IsOpen="False" Background="Transparent">
            <CommandBar.Content>
                <InkToolbar x:Name="PenTools" TargetInkCanvas="{x:Bind Ink, Mode=OneTime}" InitialControls="All"
                            AutomationProperties.AutomationId="PenTools"/>
            </CommandBar.Content>
            <AppBarButton Icon="Edit" Label="Add text" Width="40" Click="AddText_Click" AutomationProperties.AutomationId="AddText"
                          ToolTipService.ToolTip="Add text"/>
            <AppBarButton Icon="Find" Label="Analyze ink" Width="40" Click="Analyze_Click" AutomationProperties.AutomationId="AnalyzeInk"
                          ToolTipService.ToolTip="Analyze handwriting"/>
            <AppBarButton Icon="Save" Label="Save" Width="40" Click="Save_Click" AutomationProperties.AutomationId="SaveNote"
                          ToolTipService.ToolTip="Save (Ctrl+S)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_Invoked"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Delete" Label="Delete selected object" Click="Delete_Click" AutomationProperties.AutomationId="DeleteObject"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <InfoBar x:Name="Error" Grid.Row="2" Severity="Error" IsClosable="True"/>
        <ScrollViewer x:Name="CanvasScroll" Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" HorizontalContentAlignment="Left"
                      VerticalContentAlignment="Top" AutomationProperties.AutomationId="NoteCanvas"
                      AutomationProperties.Name="Note canvas">
            <Grid x:Name="Surface" Width="400" Height="400" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  ManipulationMode="None">
                <Canvas x:Name="TextLayer" IsHitTestVisible="False"/>
                <InkCanvas x:Name="Ink" AutomationProperties.AutomationId="InkCanvas"/>
                <Canvas x:Name="Adornments" IsHitTestVisible="False">
                    <Border x:Name="Selection" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                            BorderThickness="2" Visibility="Collapsed" CornerRadius="4"/>
                </Canvas>
                <Canvas x:Name="EditLayer">
                    <TextBox x:Name="TextEditor" Width="220" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap"
                             Visibility="Collapsed" TextChanged="TextEditor_TextChanged"
                             LostFocus="TextEditor_LostFocus" AutomationProperties.AutomationId="CanvasText"
                             AutomationProperties.Name="Text on the note canvas"/>
                </Canvas>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Spacing="6">
            <TextBlock Text="Pen to draw. Click to type. Tap ink to group; touch to move."
                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="Status" Text="Loading note..." TextWrapping="Wrap"
                       Style="{ThemeResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="NoteStatus"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Page>
